{
  "name": "games-movement",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:sword": "npm -w @games/sword run dev",
    "dev:tennis": "npm -w @games/tennis run dev",
    "dev:golf": "npm -w @games/golf run dev",
    "dev:lab": "npm -w @games/lab run dev",
    "build": "npm -w @games/sword run build && npm -w @games/tennis run build && npm -w @games/golf run build && npm -w @games/lab run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
