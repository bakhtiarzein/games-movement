{
  "name": "games-movement",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --config apps/vite.config.ts --open",
    "build": "vite build --config apps/vite.config.ts",
    "preview": "vite preview --config apps/vite.config.ts",
    "dev:sword": "npm -w @games/sword run dev",
    "dev:tennis": "npm -w @games/tennis run dev",
    "dev:golf": "npm -w @games/golf run dev",
    "dev:lab": "npm -w @games/lab run dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
